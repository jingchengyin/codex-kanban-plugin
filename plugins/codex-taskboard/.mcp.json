{
  "mcpServers": {
    "codex-taskboard": {
      "command": "/bin/sh",
      "args": [
        "./scripts/start-mcp.sh"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "CODEX_HOME",
        "TASKBOARD_WS_URL"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 15
    }
  }
}
