{
  "name": "codex-kanban-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node dist/server/index.js",
    "preview": "node dist/server/preview.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "codex-kanban-plugin": "node scripts/start-live.mjs",
    "live": "npm run codex-kanban-plugin"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openai/mcp-extensions": "^0.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.3.0",
    "ws": "^8.22.0"
  }
}
